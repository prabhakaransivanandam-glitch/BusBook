PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/busbook
CLIENT_URL=http://localhost:5173

# Firebase Admin (paste the service account JSON as a single line, or base64-encode it)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com"}

# QR token signing secret (use a long random string; same value used in later phases)
QR_SECRET=replace-with-a-long-random-secret
QR_TTL_DAYS=30

# Seat hold (minutes) before an unpaid booking is released
SEAT_HOLD_MINUTES=5
